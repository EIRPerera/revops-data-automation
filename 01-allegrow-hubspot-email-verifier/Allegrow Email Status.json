    {
      "parameters": {
        "jsCode": "const rows = [];\n\nfor (const item of $input.all()) {\n  rows.push({\n    \"email\": item.json[\"Email\"]\n  });\n}\n\nreturn [\n  {\n    json: {\n      data: rows\n    }\n  }\n];\n"
