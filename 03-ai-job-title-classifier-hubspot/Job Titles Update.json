    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n  try {\n    const rawText = item.json.output[0].content[0].text;\n    const parsedData = JSON.parse(rawText);\n    results.push({\n      json: {\n        contact_id: parsedData.contact_id,\n        job_function: parsedData.job_function,\n        job_seniority: parsedData.job_seniority\n      }\n    });\n  } catch (error) {\n    results.push({ json: { error: \"Could not parse text field\", details: error.message } });\n  }\n}\nreturn results;"
      },
