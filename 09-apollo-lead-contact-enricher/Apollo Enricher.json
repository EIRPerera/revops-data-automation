    {
      "parameters": {
        "jsCode": "const contact = $('Get contact details').item.json;\nconst props = contact.properties || {};\nconst person = $json.person || {};\nconst org = person.organization || {};\n\nfunction joinList(value) {\n  return Array.isArray(value) ? value.join(';') : value || '';\n}\n\nreturn [{\n  json: {\n    lead_id:$('Edit Fields').first().json.lead_id ,\n    hs_contact_id: contact.id,\n\n    first_name: person.first_name || props.firstname || '',\n    last_name: person.last_name || props.lastname || '',\n    domain: org.primary_domain || props.hs_email_domain || '',\n    email: person.email || props.email || '',\n    country: person.country || props.country || '',\n    city: person.city || props.city || '',\n    linkedin_url: person.linkedin_url || props.linkedin_url || '',\n    title: person.title || props.jobtitle || '',\n\n    email_status: person.email_status || '',\n    twitter_url: person.twitter_url || '',\n    github_url: person.github_url || '',\n    facebook_url: person.facebook_url || '',\n    extrapolated_email_confidence: person.extrapolated_email_confidence || '',\n    headline: person.headline || '',\n    street_address: person.street_address || person.address || '',\n    state: person.state || '',\n    postal_code: person.postal_code || '',\n    formatted_address: person.formatted_address || '',\n    time_zone: person.time_zone || '',\n\n    intent_strength: org.intent_strength || '',\n    show_intent: org.show_intent || '',\n    email_domain_catchall: org.email_domain_catchall || org.email_domain_catch_all || '',\n    revealed_for_current_team: person.revealed_for_current_team || '',\n\n    departments: joinList(person.departments),\n    subdepartments: joinList(person.subdepartments),\n    functions: joinList(person.functions),\n    seniority: person.seniority || ''\n  }\n}];"
      },
